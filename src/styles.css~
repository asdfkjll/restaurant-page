/* Bowlby One SC */
@font-face {
  font-family: 'Bowlby One SC';
  src: url('./fonts/BowlbyOneSC-Regular.ttf') format('truetype');
  font-weight: 400;
  font-style: normal;
  font-display: swap;
}

/* Lilita One */
@font-face {
  font-family: 'Lilita One';
  src: url('./fonts/LilitaOne-Regular.ttf') format('truetype'); /* change to .otf or .woff if your file extensions are different */
  font-weight: 400;
  font-style: normal;
  font-display: swap;
}

:root {
  --fiery-red: #bd2b14;
  --burnt-orange: #ffcc29;
  --golden-ember: #fffb00;
  --charcoal-black: #2b2d31;
  --ash-gray: #9499a1;
  --bone-white: #faf8f5;
}

body {
  font-family: "Helvetica", sans-serif;
  color: var(--charcoal-black);
  background-color: var(--bone-white);
}

h1, h2, h3, h4, h5, button {
  font-family: 'Lilita One', cursive, sans-serif;
}

h1 {
  font-size: 2rem;
}

img {
  max-width: 100%;
}

.section {
  max-width: 1080px;
  padding: 80px 24px;
  margin: auto;
}

footer {
  background-color: var(--charcoal-black);
  color: var(--bone-white);
}

.btn {
  background: none;
  outline: 0;
  margin: 0;
  border: 0;
  padding: 15px 20px;
  cursor: pointer;
  font-weight: bold;
  border-radius: 25px;
}

.btn-red {
  background: var(--fiery-red);
  color: var(--bone-white);
}

.btn-yellow {
  background: var(--golden-ember);
  color: var(--fiery-red);
}

.btn-white {
  background: var(--bone-white);
  color: var(--charcoal-black);
  border-radius: 0;
}

.logo {
  font-size: 1.3rem;
  font-weight: bold;
}

#content {
  margin-top: 61.2px;
  min-height: 100%;
}

#navbar {
  background-color: var(--fiery-red);
  color: var(--bone-white);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 15px 25px;
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 1000;
}

#navmenu ul {
  display: flex;
  list-style: none;
  gap: 15px;
}

#navmenu button {
  color: var(--bone-white);
  padding: 0;
}

.hero {
  position: relative;
  width: 100%;
  height: 60vh; 
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  color: var(--bone-white);
}

.hero-video {
  position: absolute;
  top: 50%;
  left: 50%;
  min-width: 100%;
  min-height: 100%;
  width: auto;
  height: auto;
  transform: translate(-50%, -50%);
  object-fit: cover;
  z-index: 1;
}

.hero-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.5); 
  z-index: 2;
}

.hero-content {
  position: relative;
  z-index: 3;
  max-width: 800px;
  padding: 0 25px;
}

.hero-content__btn {
  display: flex;
  gap: 15px;
}

.hero-content h1 {
  font-size: 3.5rem;
  font-weight: 700;
  margin-bottom: 1rem;
}

.hero-content p {
  font-size: 1.25rem;
  margin-bottom: 2rem;
  opacity: 0.9;
}

.offers-bg {
  width: 100vw;
  height: 500px;
  background-color: var(--burnt-orange);
  clip-path: ellipse(110% 100% at 50% 0%); 
  position: absolute;
  top: calc(61.2px + 485.4px);
  z-index: -1000;
}

.offers-header {
  font-size: 2.1rem;
  text-align: center;
  margin-bottom: 45px;
}

.offers-header h2 {
  color: var(--fiery-red);
}

.offers-content {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 15px;
}

.offers-item {
  width: 100%;
  max-width: 350px;
  background-color: var(--fiery-red);
  color: var(--bone-white);
  border-radius: 25px;
  overflow: hidden;
}

.offers-item__img-container {
  width: 100%;
  aspect-ratio: 4 / 3; 
  background-color: #f0f0f0; 
}

.offers-item__img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center; 
  display: block;
}

.offers-item__content {
  display: flex;
  flex-direction: column;
  padding: 15px;
}

.offers-item__title {
  font-size: 1.5rem;
}

.offers-item__discount {
  font-size: 2.5rem;
  font-weight: bold;
  color: var(--golden-ember);
  margin-bottom: 10px;
}

.offers-content .btn {
  align-self: flex-end;
  padding: 5% 10%;
}

.values-content {
  display: flex;
  flex-direction: column;
  gap: 105px;
}

.values-item {
  display: flex;
  gap: 35px;
  align-items: center;
}

.values-item__img-container {
  width: 70%;
  height: 325px;
  background-color: #f0f0f0;
  border-radius: 15px;
}

.values-item__img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center; 
  border-radius: inherit;
}

.values-item__text {
  width: 100%;
  font-size: 1.5rem;
}

.values-item__text h2 {
  color: var(--fiery-red);
  font-size: 2.5rem;
}

.values-content > :nth-child(2) {
  flex-direction: row-reverse;
}

#about {
  background-color: var(--fiery-red);
  color: var(--bone-white);
  height: 500px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  clip-path: polygon(0 4%, 100% 0, 100% 96%, 0 100%);
}

.about-header {
  font-size: 1.8rem;
  text-align: center;
  margin-bottom: 25px;
}

.about-header h2 {
  max-width: 500px;
}

.about-content {
  display: flex;
  gap: 15px;
}

.promotions-content {
  display: flex;
  flex-direction: column;
  gap: 105px;
}

.promotions-item {
  display: flex;
  gap: 35px;
  align-items: center;
}

.promotions-item__img-container {
  width: 85%;
  background-color: #f0f0f0;
  border-radius: 15px;
}

.promotions-item__img {
  width: 100%;
  height: 100%;
  object-fit: contain;
  object-position: center; 
  border-radius: inherit;
}

.promotions-item__container {
  width: 100%;
  display: flex;
  flex-direction: column;
}

.promotions-item__container h2 {
  color: var(--fiery-red);
  font-size: 2.5rem;
}

.promotions-item__container .btn {
  align-self: flex-end;
  margin-top: 25px;
}

.promotions-content > :nth-child(2) {
  flex-direction: row-reverse;
}

/* Main Section (The Yellow Background) */
.app {
  background-color: var(--burnt-orange); /* Yellow background color */
  padding: 40px 0;
  margin-top: 60px; /* Space above to allow the phone header to spill over */
  position: relative;
}

/* Container to center and align elements horizontally */
.app__container {
  max-width: 1100px;
  margin: 0 auto;
  display: flex;
  align-items: center;
  padding: 0 20px;
}

/* Phone Image Wrapper */
.app__img-container {
  flex: 1;
  position: relative;
}

.app__img {
  max-width: 320px;
  height: auto;
  display: block;
  
  /* KEY TECHNIQUE 1: Shift image upward and downward outside the section */
  margin-top: -80px; 
  margin-bottom: -80px;
  
  /* Optional: Soft glow behind the phone seen in the image */
  filter: drop-shadow(0 0 40px rgba(255, 255, 255, 0.4));
}

/* Content Area Right Side */
.app__content {
  flex: 1.5;
  padding-left: 40px;
  color: var(--charcoal-black);
}

.app__title {
  font-size: 2.5rem;
  font-weight: 900;
  color: #a80000; /* Dark Red text */
  margin-bottom: 20px;
}

.app__title--accent {
  color: var(--fiery-red);
}

.app__tagline {
  font-size: 0.85rem;
  font-weight: 700;
  letter-spacing: 0.5px;
}

